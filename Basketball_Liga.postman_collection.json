                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Los Leones\",\n  \"entrenador\": \"Roberto García\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/equipos", "host": ["{{baseUrl}}"], "path": ["equipos"] }
          }
        },
        {
          "name": "POST Crear sin token (debe dar 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Equipo Sin Auth\",\n  \"entrenador\": \"Nadie\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/equipos", "host": ["{{baseUrl}}"], "path": ["equipos"] }
          }
        },
        {
          "name": "POST Crear sin campos requeridos (debe dar 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Solo Nombre\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/equipos", "host": ["{{baseUrl}}"], "path": ["equipos"] }
          }
        },
        {
          "name": "GET Equipo por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/equipos/{{equipoLocalId}}", "host": ["{{baseUrl}}"], "path": ["equipos", "{{equipoLocalId}}"] }
          }
        },
        {
          "name": "PUT Editar Equipo",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Los Tigres FC\",\n  \"entrenador\": \"Carlos Mendoza Jr.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/equipos/{{equipoLocalId}}", "host": ["{{baseUrl}}"], "path": ["equipos", "{{equipoLocalId}}"] }
          }
        },
        {
          "name": "GET ID inválido (debe dar 400)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/equipos/id-no-valido", "host": ["{{baseUrl}}"], "path": ["equipos", "id-no-valido"] }
          }
        }
      ]
    },
    {
