            },
            "url": { "raw": "{{baseUrl}}/jugadores/{{jugadorId}}", "host": ["{{baseUrl}}"], "path": ["jugadores", "{{jugadorId}}"] }
          }
        },
        {
          "name": "DELETE Jugador",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
