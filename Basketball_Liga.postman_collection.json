{
  "info": {
    "name": "Basketball Liga API",
    "description": "Colección completa para testear la API de Liga de Baloncesto Juvenil. Flujo recomendado: 1) Setup Admin → 2) Login → 3) Equipos → 4) Jugadores → 5) Partidos → 6) Resultados → 7) Clasificación",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "equipoLocalId", "value": "", "type": "string" },
    { "key": "equipoVisitanteId", "value": "", "type": "string" },
    { "key": "jugadorId", "value": "", "type": "string" },
    { "key": "partidoId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔧 0 - Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "🔐 1 - Auth",
      "item": [
        {
          "name": "Crear Admin (setup inicial)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/setup", "host": ["{{baseUrl}}"], "path": ["auth", "setup"] }
          }
        },
        {
          "name": "Login (guarda token automáticamente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('✅ Token guardado');",
                  "} else {",
                  "  console.log('❌ No se encontró token en la respuesta');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login incorrecto (debe dar 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login sin campos (debe dar 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "🏀 2 - Equipos",
      "item": [
        {
          "name": "GET Todos los equipos (público)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/equipos", "host": ["{{baseUrl}}"], "path": ["equipos"] }
          }
        },
        {
          "name": "POST Crear Equipo Local (guarda ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res._id) {",
                  "  pm.collectionVariables.set('equipoLocalId', res._id);",
                  "  console.log('✅ equipoLocalId guardado:', res._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Los Tigres\",\n  \"entrenador\": \"Carlos Mendoza\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/equipos", "host": ["{{baseUrl}}"], "path": ["equipos"] }
          }
        },
        {
          "name": "POST Crear Equipo Visitante (guarda ID)",
